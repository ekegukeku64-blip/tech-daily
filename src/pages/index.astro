---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;

// Group by month
const grouped: Record<string, typeof sortedPosts> = {};
sortedPosts.forEach(post => {
  const key = post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
  if (!grouped[key]) grouped[key] = [];
  grouped[key].push(post);
});
---

<BaseLayout title="首页">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div class="mb-10">
      <h1 class="font-serif text-3xl font-bold mb-2">技术日报</h1>
      <p class="text-ink-muted dark:text-dark-ink-muted">GitHub 热门项目 + 技术圈每日动态，一天一读。</p>
    </div>

    {Object.entries(grouped).map(([month, posts]) => (
      <section class="mb-10">
        <h2 class="text-sm font-semibold tracking-widest text-ink-muted dark:text-dark-ink-muted mb-4 uppercase">{month}</h2>
        <div class="space-y-3">
          {posts.map((post, i) => (
            <a
              href={`${base}${post.id.replace(/\.md$/, '')}/`}
              class="group block p-4 border border-border/30 dark:border-dark-border/30 hover:border-accent/50 dark:hover:border-dark-accent/50 hover:-translate-y-0.5 transition-all duration-200 fade-in"
              style={`animation-delay: ${i * 0.05}s`}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-ink dark:text-dark-ink group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-ink-muted dark:text-dark-ink-muted mt-1 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {post.data.tags.map(tag => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>
                </div>
                <time class="text-xs text-ink-muted dark:text-dark-ink-muted whitespace-nowrap font-mono pt-1">
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    {sortedPosts.length === 0 && (
      <div class="text-center py-20 text-ink-muted dark:text-dark-ink-muted">
        <p class="text-lg font-serif">还没有日报</p>
        <p class="text-sm mt-1">在 <code class="px-2 py-0.5 bg-paper-alt dark:bg-dark-paper-alt rounded">src/content/posts/</code> 下添加 Markdown 文件即可</p>
      </div>
    )}
  </div>
</BaseLayout>
